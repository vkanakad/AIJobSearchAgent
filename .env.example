# Copy to .env and fill values
# Email SMTP settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-smtp-password
EMAIL_TO=vinay04c8@gmail.com

# Search settings
RESUME_PATH=resume.txt
KEYWORDS=software engineer,backend,python
LOCATION_FILTER=Austin,Remote
SPONSORSHIP_KEYWORDS=visa,sponsorship,H-1B,H1B,sponsor
SIMILARITY_THRESHOLD=0.12
MAX_RESULTS=50

# Scheduling (local scheduler requires process to keep running). Format HH:MM in 24h
DAILY_RUN_TIME=09:00

# SerpAPI (optional - use to fetch Google Jobs / LinkedIn results via SerpAPI)
SERPAPI_KEY=